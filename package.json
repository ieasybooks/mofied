{
  "name": "mofied",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "build": "bun run --cwd apps/web build",
    "build:web:release": "bun run --cwd apps/web build:release",
    "preview:cloudflare": "bun run --cwd apps/web preview:cloudflare",
    "deploy:web:check": "bun run --cwd apps/web deploy:check",
    "deploy:web": "bun run --cwd apps/web deploy",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native-cache": "bash scripts/test-native-interruption-cache.sh",
    "test:android-lifecycle": "bash scripts/test-android-lifecycle.sh",
    "fastlane:check": "bundle exec fastlane lanes",
    "check": "bun run typecheck && bun run test && bun run build",
    "release:check": "ieasybooks-release store check --app apps/mobile",
    "mobile:export": "bun run --cwd apps/mobile export",
    "contract:generate": "bun scripts/generate-contract.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@ieasybooks/release": "github:ieasybooks/release#c361cc1146ffe9349e3b6e592c5bfa0260499bf6",
    "@mofied/contracts": "workspace:*",
    "@mofied/design": "workspace:*",
    "@mofied/fixtures": "workspace:*",
    "@mofied/session": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.158.0",
    "zod": "^4.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "patchedDependencies": {
    "expo-video@58.0.13": "apps/mobile/patches/expo-video@58.0.13.patch"
  }
}
