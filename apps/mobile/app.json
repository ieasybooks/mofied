{
  "expo": {
    "name": "مفيد",
    "slug": "mofied",
    "scheme": "mofied",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "../../packages/design/assets/icons/app-icon-flat-dark-1024.png",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "KJ597HLVMB",
      "bundleIdentifier": "com.mofied.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:mofied.com"]
    },
    "android": {
      "package": "com.mofied.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mofied.com",
              "path": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      "./plugins/with-release-signing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "../../packages/design/assets/icons/icon-white-1024.png",
          "imageWidth": 80,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "../../packages/design/assets/icons/app-icon-flat-dark-1024.png"
    }
  }
}
