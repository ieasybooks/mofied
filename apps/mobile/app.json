{
  "expo": {
    "name": "مفيد",
    "slug": "mofied",
    "scheme": "mofied",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "../../packages/design/assets/icons/app-icon-flat-dark-1024.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mofied.app",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.mofied.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "../../packages/design/assets/icons/icon-white-1024.png",
          "imageWidth": 80,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "../../packages/design/assets/icons/app-icon-flat-dark-1024.png"
    }
  }
}
