# The release build appends exact fingerprinted asset paths for immutable caching.
# A wildcard /assets/* rule would also cache 404s for missing files for a year.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Apple fetches the app association file without an extension; it must be JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
