{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mofied-web",
  "account_id": "aaed7434338705aa46de5e4e3575e02b",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  // Terraform in ieasybooks/infrastructure owns the mofied.com custom domain.
  // Omit routes: Wrangler must not manage that association on app releases.
  "assets": {
    "directory": "./dist",
    // Player screens use /; the About, privacy, terms and support pages are
    // standalone HTML, such as privacy.html for /privacy (see scripts/legal-pages.ts).
    // Unknown paths and stale asset URLs must be 404s,
    // not HTML responses cached as immutable JavaScript.
    "not_found_handling": "none",
  },
}
