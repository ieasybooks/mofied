{
  "name": "@mofied/web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:release": "VITE_SESSION_API_URL=https://faqieh.com/api/v1/mofied/session?locale=ar vite build && bun scripts/write-asset-headers.ts",
    "preview:cloudflare": "bun run build:release && wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "deploy:check": "bun run build:release && wrangler deploy --dry-run",
    "deploy": "bun run build:release && wrangler deploy"
  },
  "dependencies": {
    "@mofied/contracts": "workspace:*",
    "@mofied/session": "workspace:*",
    "@mofied/design": "workspace:*",
    "@mofied/fixtures": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "hls.js": "^1.6.0",
    "lucide-react": "1.69.0"
  },
  "devDependencies": {
    "vite": "8.3.6",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}
