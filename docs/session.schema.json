{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "locale": { "type": "string", "enum": ["ar", "en"] },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "maxActiveMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 86400000
        },
        "limitBehavior": { "type": "string", "const": "finish-current-item" },
        "maxConsecutiveFailures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": ["maxActiveMs", "limitBehavior", "maxConsecutiveFailures"],
      "additionalProperties": false
    },
    "items": {
      "minItems": 1,
      "maxItems": 250,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "media" },
              "id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "mediaId": { "type": "string", "minLength": 1, "maxLength": 160 },
              "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "pageUrl": { "type": "string", "format": "uri" },
              "posterUrl": {
                "anyOf": [
                  { "type": "string", "format": "uri" },
                  { "type": "null" }
                ]
              },
              "durationMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "playback": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "mimeType": {
                    "type": "string",
                    "enum": ["application/vnd.apple.mpegurl", "video/mp4"]
                  }
                },
                "required": ["url", "mimeType"],
                "additionalProperties": false
              },
              "speaker": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "name": { "type": "string", "minLength": 1 },
                  "pageUrl": { "type": "string", "format": "uri" },
                  "imageUrl": {
                    "anyOf": [
                      { "type": "string", "format": "uri" },
                      { "type": "null" }
                    ]
                  }
                },
                "required": ["id", "name", "pageUrl", "imageUrl"],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "id",
              "mediaId",
              "title",
              "pageUrl",
              "posterUrl",
              "durationMs",
              "playback",
              "speaker"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "reminder" },
              "id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "durationMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 300000
              },
              "content": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["quran", "text"] },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "citation": { "type": "string" },
                  "source": { "type": "string" }
                },
                "required": ["kind", "body", "citation", "source"],
                "additionalProperties": false
              }
            },
            "required": ["kind", "id", "durationMs", "content"],
            "additionalProperties": false
          }
        ]
      }
    },
    "replacements": {
      "maxItems": 25,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "const": "media" },
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "mediaId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "pageUrl": { "type": "string", "format": "uri" },
          "posterUrl": {
            "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "playback": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "mimeType": {
                "type": "string",
                "enum": ["application/vnd.apple.mpegurl", "video/mp4"]
              }
            },
            "required": ["url", "mimeType"],
            "additionalProperties": false
          },
          "speaker": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "name": { "type": "string", "minLength": 1 },
              "pageUrl": { "type": "string", "format": "uri" },
              "imageUrl": {
                "anyOf": [
                  { "type": "string", "format": "uri" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["id", "name", "pageUrl", "imageUrl"],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "id",
          "mediaId",
          "title",
          "pageUrl",
          "posterUrl",
          "durationMs",
          "playback",
          "speaker"
        ],
        "additionalProperties": false
      }
    },
    "ending": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      },
      "required": ["title", "body"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "locale",
    "expiresAt",
    "policy",
    "items",
    "replacements",
    "ending"
  ],
  "additionalProperties": false
}
