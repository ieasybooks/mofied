index 0000000000000000000000000000000000000000..43c71feb1537528b9160e27f5c22ad311c0f082e
--- /dev/null
+++ b/ios/AudioInterruptionState.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/** Copy the state and listener under the same lock; never invoke a listener while locked. */
+final class AudioInterruptionState: @unchecked Sendable {
+  private let lock = NSLock()
+  private var state = ["interrupted": false, "mayResume": true]
+  private var listener: (([String: Bool]) -> Void)?
+
+  var snapshot: [String: Bool] {
+    lock.lock()
+    defer { lock.unlock() }
+    return state
+  }
+
+  func setListener(_ value: (([String: Bool]) -> Void)?) {
+    lock.lock()
+    defer { lock.unlock() }
+    listener = value
+  }
+
+  func update(interrupted: Bool, mayResume: Bool) {
+    let payload = ["interrupted": interrupted, "mayResume": mayResume]
+    lock.lock()
+    state = payload
+    let callback = listener
+    lock.unlock()
+    callback?(payload)
+  }
+}
