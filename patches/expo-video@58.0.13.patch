index 0000000000000000000000000000000000000000..5d7307365a9ca52ea60dc2239a14563db0c9b982
--- /dev/null
+++ b/android/src/main/java/expo/modules/video/managers/SessionAudioFocus.kt
@@ -0,0 +1,132 @@
+package expo.modules.video.managers
+
+import android.media.AudioAttributes
+import android.media.AudioFocusRequest
+import android.media.AudioManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+
+/** Main-thread owner for a logical foreground session, independent of VideoPlayers. */
+internal class SessionAudioFocus(
+  private val audioManager: AudioManager,
+  private val pausePlayers: () -> Unit,
+  private val emit: (Map<String, Any>) -> Unit
+) {
+  private enum class State { NONE, GRANTED, TRANSIENT, DELAYED, DENIED, LOST }
+  private var state = State.NONE
+  private var active = false
+  private var generation = 0
+  private var request: AudioFocusRequest? = null
+  private var legacyListener: AudioManager.OnAudioFocusChangeListener? = null
+  private var requestSerial = 0
+  private val handler = Handler(Looper.getMainLooper())
+
+  val canPlay: Boolean get() = active && state == State.GRANTED
+
+  fun setActive(value: Boolean, generation: Int) {
+    this.generation = generation
+    active = value
+    if (!value) {
+      abandon()
+      state = State.NONE
+      pausePlayers()
+      publish(false, true)
+      return
+    }
+    when (state) {
+      State.GRANTED -> publish(false, true)
+      State.TRANSIENT, State.DELAYED -> publish(true, false)
+      else -> acquire()
+    }
+  }
+
+  private fun acquire() {
+    val serial = ++requestSerial
+    val listener = AudioManager.OnAudioFocusChangeListener { change ->
+      handler.post {
+        if (active && serial == requestSerial) onFocusChange(change)
+      }
+    }
+    val result = try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+        val next = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
+          .setAudioAttributes(AudioAttributes.Builder()
+            .setUsage(AudioAttributes.USAGE_MEDIA)
+            .setContentType(AudioAttributes.CONTENT_TYPE_MOVIE)
+            .build())
+          // Without this flag Android can duck without delivering a loss callback.
+          .setWillPauseWhenDucked(true)
+          .setAcceptsDelayedFocusGain(true)
+          .setOnAudioFocusChangeListener(listener, handler)
+          .build()
+        request = next
+        audioManager.requestAudioFocus(next)
+      } else {
+        legacyListener = listener
+        @Suppress("DEPRECATION")
+        audioManager.requestAudioFocus(listener, AudioManager.STREAM_MUSIC, AudioManager.AUDIOFOCUS_GAIN)
+      }
+    } catch (_: SecurityException) {
+      AudioManager.AUDIOFOCUS_REQUEST_FAILED
+    }
+    when (result) {
+      AudioManager.AUDIOFOCUS_REQUEST_GRANTED -> {
+        state = State.GRANTED
+        publish(false, true)
+      }
+      AudioManager.AUDIOFOCUS_REQUEST_DELAYED -> {
+        state = State.DELAYED
+        pausePlayers()
+        publish(true, false)
+      }
+      else -> {
+        abandon()
+        state = State.DENIED
+        pausePlayers()
+        // No gain callback is promised after denial. Require explicit retry.
+        publish(false, false)
+      }
+    }
+  }
+
+  private fun onFocusChange(change: Int) {
+    when (change) {
+      AudioManager.AUDIOFOCUS_LOSS -> {
+        abandon()
+        state = State.LOST
+        pausePlayers()
+        publish(false, false)
+      }
+      AudioManager.AUDIOFOCUS_LOSS_TRANSIENT,
+      AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK -> {
+        state = State.TRANSIENT
+        pausePlayers()
+        publish(true, false)
+      }
+      AudioManager.AUDIOFOCUS_GAIN -> {
+        state = State.GRANTED
+        // JavaScript reconciles manual pause, About, and background intent.
+        publish(false, true)
+      }
+    }
+  }
+
+  private fun abandon() {
+    ++requestSerial // Ignore already-queued callbacks from an abandoned request.
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+      request?.let { audioManager.abandonAudioFocusRequest(it) }
+    } else {
+      legacyListener?.let {
+        @Suppress("DEPRECATION")
+        audioManager.abandonAudioFocus(it)
+      }
+    }
+    request = null
+    legacyListener = null
+  }
+
+  private fun publish(interrupted: Boolean, mayResume: Boolean) {
+    emit(mapOf("interrupted" to interrupted, "mayResume" to mayResume, "focusGeneration" to generation))
+  }
+}
